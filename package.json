{
  "name": "parallax",
  "version": "0.1.0",
  "description": "Multi-OEM Vehicle Telemetry Normalization and Event Processing Platform",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test --import ./tests/setup.js tests/**/*.test.js",
    "test:unit": "NODE_ENV=test node --test --import ./tests/setup.js tests/unit/**/*.test.js",
    "test:integration": "NODE_ENV=test node --test --import ./tests/setup.js tests/integration/**/*.test.js",
    "test:api": "NODE_ENV=test node --test --import ./tests/setup.js tests/api/**/*.test.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "dotenv": "^18.0.9",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "supertest": "^7.1.0"
  },
  "license": "MIT",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
