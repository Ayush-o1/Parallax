# ─────────────────────────────────────────────────────────────────────────────
# Parallax — Environment Variable Reference
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (development) ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://parallax_app:parallax_dev_secret@localhost:5432/parallax_dev"

# ── PostgreSQL (test) ─────────────────────────────────────────────────────────
# Used by the automated test suite. Kept separate from development data so
# tests can safely truncate or reset tables without affecting your dev state.
TEST_DATABASE_URL="postgresql://parallax_app:parallax_dev_secret@localhost:5432/parallax_test"

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted values: debug | info | warn | error
LOG_LEVEL=debug

# ── Telemetry Ingestion ───────────────────────────────────────────────────────
# Maximum accepted payload size in bytes.
# 64 KB is generous for a single telemetry event; adjust if batch ingestion grows.
MAX_PAYLOAD_BYTES=65536

# ── Vehicle State ─────────────────────────────────────────────────────────────
# A vehicle is considered stale (no longer actively reporting) after this many
# seconds without a new telemetry reading being received.
# Different OEMs report at different frequencies; this is a platform-wide default.
STALE_VEHICLE_THRESHOLD_SECONDS=300

# ── Future: Redis (Phase 10) ──────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Future: Authentication (Phase 9) ─────────────────────────────────────────
# JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
# TOKEN_EXPIRY_SECONDS=3600
