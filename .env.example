# ─────────────────────────────────────────────────────────────────────────────
# Parallax — Environment Variable Reference
# Copy this file to .env and fill in your local values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL (development) ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://parallax_app:parallax_dev_secret@localhost:5432/parallax_dev"

# ── PostgreSQL (test) ─────────────────────────────────────────────────────────
# Used exclusively when NODE_ENV=test. The test bootstrap maps this value
# to DATABASE_URL before loading application code and rejects other DB names.
TEST_DATABASE_URL="postgresql://parallax_app:parallax_dev_secret@localhost:5432/parallax_test"

# ── Logging ───────────────────────────────────────────────────────────────────
# Accepted values: debug | info | warn | error
LOG_LEVEL=debug

# ── Telemetry Ingestion ───────────────────────────────────────────────────────
# Maximum accepted payload size in bytes (64 KB default).
MAX_PAYLOAD_BYTES=65536

# ── Per-OEM Reporting Intervals ───────────────────────────────────────────────
# Expected telemetry frequency for each OEM source (seconds).
# Used to calculate per-source stale thresholds.
# Alpha reports every 30s, Beta every 60s, Gamma every 15s.
OEM_ALPHA_INTERVAL_SECONDS=30
OEM_BETA_INTERVAL_SECONDS=60
OEM_GAMMA_INTERVAL_SECONDS=15

# ── Stale Vehicle Detection ───────────────────────────────────────────────────
# A vehicle is considered stale when:
#   now - lastReceivedAt > (OEM_interval * STALE_VEHICLE_FACTOR)
#
# Factor of 3 means: Alpha → stale after 90s, Beta → 180s, Gamma → 45s.
# This prevents false positives caused by a single missed report.
STALE_VEHICLE_FACTOR=3

# Fallback threshold (seconds) when the OEM source is unknown.
STALE_VEHICLE_FALLBACK_SECONDS=300

# ── Timestamp Acceptance Window ───────────────────────────────────────────────
# Events with eventTime older than this many seconds are quarantined.
# 86400 = 24 hours. Allows for OEM batch uploads and delayed delivery.
MAX_EVENT_AGE_PAST_SECONDS=86400

# Events with eventTime more than this many seconds in the future are
# quarantined. 300 = 5 minutes. Accommodates minor clock skew.
MAX_EVENT_AGE_FUTURE_SECONDS=300

# ── Derived Event Thresholds ────────────────────────────────────────────────
# Speed (km/h) a vehicle must exceed to begin a trip.
TRIP_START_SPEED_KPH=5

# Seconds a vehicle must remain below TRIP_START_SPEED_KPH to end a trip.
TRIP_END_STATIONARY_SECONDS=120

# Seconds a vehicle must be stationary (engine on) to trigger idling alert.
IDLING_THRESHOLD_SECONDS=180

# ── Future: Redis (Phase 10) ──────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Future: Authentication (Phase 9) ─────────────────────────────────────────
# JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
# TOKEN_EXPIRY_SECONDS=3600
