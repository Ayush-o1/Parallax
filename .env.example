# Local development only. Copy to .env; never commit .env or production secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://parallax_app:parallax_dev_secret@localhost:5433/parallax_dev
TEST_DATABASE_URL=postgresql://parallax_app:parallax_dev_secret@localhost:5433/parallax_test
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5

# Runtime security. Development uses the local-only signing key in config/env.js.
# Production MUST set TOKEN_SIGNING_SECRET and METRICS_TOKEN to random values
# with at least 32 bytes. Use a secret manager; never copy the sample values.
TOKEN_SIGNING_SECRET=
METRICS_TOKEN=
ACCESS_TOKEN_SECONDS=3600
TRUST_PROXY_HOPS=0

# Ingestion / API controls
API_RATE_LIMIT_PER_MINUTE=1200
TOKEN_RATE_LIMIT=20
MAX_PAYLOAD_BYTES=65536
MAX_BATCH_EVENTS=500
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
LOG_LEVEL=info

# Worker / Redis. If REDIS_URL is set, ingestion uses durable BullMQ jobs.
# Production requires a managed, persistent Redis-compatible service.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=8
WORKER_METRICS_PORT=9465
STREAM_METRICS_PORT=9466

# Kafka/Redpanda. Streaming is optional; when disabled, normalized readings
# and operational events stay durable in PostgreSQL and no outbox rows accrue.
STREAMING_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=parallax
KAFKA_PARTITIONS=3
KAFKA_TELEMETRY_TOPIC=telemetry.normalized.v1
KAFKA_EVENTS_TOPIC=operational.events.v1

# Source-aware stale vehicle thresholds (seconds)
OEM_ALPHA_INTERVAL_SECONDS=30
OEM_BETA_INTERVAL_SECONDS=60
OEM_GAMMA_INTERVAL_SECONDS=15
STALE_VEHICLE_FACTOR=3
STALE_VEHICLE_FALLBACK_SECONDS=300

# Event-time acceptance window and detection thresholds
MAX_EVENT_AGE_PAST_SECONDS=86400
MAX_EVENT_AGE_FUTURE_SECONDS=300
TRIP_START_SPEED_KPH=5
TRIP_END_STATIONARY_SECONDS=120
IDLING_THRESHOLD_SECONDS=180
HARD_BRAKING_ACCEL_MSS=-3

# Optional simulator / benchmark client settings
SIM_SOURCE=OEM_ALPHA
SIM_VEHICLES=3
SIM_SPEED=1
SIM_INTERVAL_MS=
INGEST_URL=http://localhost:3000/api/v1/ingest
PARALLAX_TOKEN=
# Optional ADMIN bearer used only to register synthetic VINs. Keep
# PARALLAX_TOKEN scoped to INGESTOR for telemetry uploads.
PARALLAX_ADMIN_TOKEN=
BENCH_URL=http://localhost:3000
BENCH_EVENTS=1000
BENCH_CONCURRENCY=16
BENCH_BATCH_SIZE=25
